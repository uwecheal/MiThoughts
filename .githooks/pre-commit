#!/bin/sh
# Blocks commits that would publish private mind maps or local paths.
# Enabled per clone with: git config core.hooksPath .githooks
status=0
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -iE '\.(itmz|itm|itmz-style|mythoughts|mithoughts|mm|opml)$|(^|/)(mapdata\.xml|preview\.png)$|\.assets/' || true)
if [ -n "$blocked" ]; then
    echo "pre-commit: refusing to commit mind-map files (they may be private):"
    echo "$blocked" | sed 's/^/  /'
    status=1
fi
if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -E 'Mobile Documents|iCloud~|/Users/[A-Za-z0-9._-]+/' >/dev/null; then
    echo "pre-commit: staged changes contain a local or iCloud path. Remove it before committing."
    status=1
fi
exit $status
